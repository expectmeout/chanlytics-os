{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "corepack": true
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "corepack": true
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "corepack": true
    }
  },
  "submit": { "production": {} }
}
