{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "corepack": true
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "corepack": true,
      "uploadSourceMaps": true
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "corepack": true,
      "uploadSourceMaps": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "SET_IN_APP_STORE_CONNECT",
        "appleTeamId": "SET_FROM_THE_APPLE_ACCOUNT"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
