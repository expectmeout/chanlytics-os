# Chanlytics dashboard — environment manifest (values live in Vercel project env)
#
# Pinned by tooling/scripts/tests/repo/env-manifest.test.mjs: add a process.env
# read without adding it here and the suite fails. Every variable is read in one
# place, src/server/env.ts (src/lib/public-env.ts for the NEXT_PUBLIC_ ones the
# browser reads), typed by one zod schema; a read anywhere else is a lint error.
# A production deployment missing one marked REQUIRED IN PRODUCTION refuses to
# start (instrumentation.ts) and logs env_invalid with the names.
#
# The dashboard is a SEPARATE Vercel project from apps/edge and deploys
# independently. That independence is why the two manifests are separate files:
# they genuinely need different variables, and the edge does not want a service
# credential it never uses.

# Supabase — the browser half. NEXT_PUBLIC_* is compiled into client bundles and
# is public by design; the anon key is safe there because RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=         # REQUIRED IN PRODUCTION
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # REQUIRED IN PRODUCTION

# The lead map's streets: where the basemap bundle lives (basemap.pmtiles,
# fonts/, sprites/v4/ under one address -- docs/runbook.md, "The lead map's
# streets"). A public Storage folder on the Supabase project, or a same-origin
# path. Empty = the map stays the square plot, with no request to anyone.
NEXT_PUBLIC_LEAD_MAP_BASE=

# Supabase — the server half. Service role BYPASSES RLS. It is used only by
# src/server/service.ts (job scheduling, Storage removal, the control claims)
# and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=        # REQUIRED IN PRODUCTION

# Cross-calling the edge: its diagnostics, and the doors only it can open.
DIAG_KEY=
# Where the edge is: an origin only, no path, https in production. REQUIRED IN
# PRODUCTION (production's value is https://chanlytics-messaging.vercel.app).
# Empty on a preview or a laptop = that address, as before; a preview may point
# at a staging edge.
EDGE_URL=
# The secret that signs a per-call token to the edge's admin doors (one door,
# one workspace, one person, one minute). Set the SAME value on the edge: with
# it, every call carries the token and no key, and an edge without it refuses
# them, so the two projects hold it together or not at all. REQUIRED IN
# PRODUCTION. Empty on a preview, the shared DIAG_KEY rides instead (a security
# switch with a sunset: packages/contracts SECURITY_SWITCHES).
EDGE_CALL_SECRET=
# The key that seals the unsubscribe link every campaign email carries
# (/u/<token>, Reach out). This page opens the links; the edge seals them, so
# it holds the SAME value, and every domains sweep it opens one here and pages
# the platform if it is refused (email_unsubscribe_links_broken). Generate it
# once, with the command in docs/runbook.md, "Turn on cold email". Empty = the page cannot tell a link from a
# guess and says "That didn't go through" instead of recording anything, and
# logs unsubscribe_unavailable once a minute at most. A link no key here made
# logs unsubscribe_bad_link, once a minute at most, with how many since.
UNSUBSCRIBE_SECRET=
# The unsubscribe key before the current one, while a rotation settles: a link
# already in somebody's inbox must keep working for at least 30 days (CAN-SPAM).
# To rotate, move the current value here, then set the new one above on both
# projects. Clear it once the old links no longer need to open. Empty = only
# links sealed under UNSUBSCRIBE_SECRET open.
UNSUBSCRIBE_SECRET_PREVIOUS=
# The cold link host (Reach out D17): the SAME value as the edge's
# UNSUBSCRIBE_ORIGIN, an https origin added to this project. On that host this
# project answers /u/ and nothing else. Empty = no such host.
UNSUBSCRIBE_ORIGIN=
# The email channel's mail domain: the subdomain workspaces' addresses are on
# (mail.chanlytics.com). Set the SAME value on the edge, which sends and
# receives on it. The dashboard needs it because a reply by email is queued with
# the request it will leave as, and that request names the workspace's address.
# Empty = email is off here: a reply by email is refused in words.
EMAIL_DOMAIN=
# Signs the state on the Google OAuth round trip. Empty in production = Connect
# Google is not offered (the door key never signs a production state). Empty on
# a preview or a laptop = DIAG_KEY signs it, logged google_state_signed_by_diag_key
# once (a security switch with a sunset: packages/contracts SECURITY_SWITCHES).
GOOGLE_OAUTH_STATE_SECRET=
# A preview or a laptop that may reach the real providers through the edge
# EDGE_URL names (one holding sandbox keys): set it to the word live. Empty =
# only production reaches them (src/server/deployment.ts decides once).
EDGE_PROVIDERS=
# The model Ask answers on: one of contracts' ASK_MODELS (claude-opus-5-5,
# claude-sonnet-5). Empty = the default, claude-opus-5-5. An unknown name runs
# the default and is logged once (ask_model_unknown). A change is a redeploy;
# the prompt cache misses once and warms again.
ASK_MODEL=

# The product's one address, a host (app.chanlytics.com). On production, any
# *.vercel.app host redirects to it — cookies are per-origin, and an OAuth
# callback registered against one host cannot land on another — and the
# carriers' paper consent form prints it. REQUIRED IN PRODUCTION. Empty on a
# preview = no redirect, which is what a preview wants, and the form prints
# app.chanlytics.com.
CANONICAL_HOST=

# Build identity. Set automatically by Vercel; NEXT_PUBLIC_BUILD_SHA is derived
# from VERCEL_GIT_COMMIT_SHA in next.config and keys the surface cache, so a
# deploy that changes a viewmodel shape starts cold instead of restoring an old
# shape into new components.
# VERCEL_GIT_COMMIT_SHA=   (provided by Vercel)
# VERCEL_ENV=              (provided by Vercel)
NEXT_PUBLIC_BUILD_SHA=

# Sign-up posture: empty is open; `waitlist` is the list; any other value is
# the invite code (compared in constant time). Asked on /signup by the email
# form, and again of a FIRST workspace on /api/v1/workspaces/create, which is
# the door for an account that arrived through Sign in with Google.
SIGNUP_CODE=

# The phone app's links (app/api/app-links): which apps may open this domain's
# links, one variable per store; unset, each file is a 404. Apple takes
# TEAMID.bundle.id, several separated by commas. Android takes
# package=FINGERPRINT|FINGERPRINT;package2=FINGERPRINT (SHA-256 certificate).
APP_LINKS_APPLE=
APP_LINKS_ANDROID=

# The oldest phone app this site still speaks to, as the app reports itself (1.2.0). An older shell shows
# "update the app" (apps/mobile). Blank welcomes every version.
MIN_APP_VERSION=
