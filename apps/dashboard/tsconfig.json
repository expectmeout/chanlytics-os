{
  "//": [
    "Next resolves for the dashboard, so the base's bundler resolution stands. Next leaves a tsconfig that extends",
    "another alone (it rewrote this one's jsx before). noUncheckedIndexedAccess waits here until the dashboard's index",
    "reads are guarded: tests/types/index-reads-are-counted.test.mjs counts them."
  ],
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/legacy"]
}
