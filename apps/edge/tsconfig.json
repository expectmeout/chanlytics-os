{
  "//": "Vanilla Node functions: an import specifier carries its .js suffix, so NodeNext resolves them.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "lib/**/*.ts"]
}
