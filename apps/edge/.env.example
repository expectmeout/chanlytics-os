# Chanlytics edge — environment manifest (values live in Vercel project env, Production scope only)
#
# This file is the COMPLETE list of variables apps/edge and the packages it
# bundles read from process.env. A test pins it (tooling/scripts/tests/
# env-manifest.test.mjs): add a process.env read without adding it here and the
# suite fails. Nine variables were missing before that test existed, including
# the two flags that decide where the bot's memory comes from and the Supabase
# credentials — so an environment built from this file persisted nothing, and
# said nothing about it.

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=   # permanent System User token — verify expires_at=0 via /debug_token
WHATSAPP_PHONE_ID=
META_APP_SECRET=
META_APP_ID=             # /api/diag token introspection, and Embedded Signup (the browser hands it to Meta's SDK); empty = the live app (lib/meta-graph.ts DEFAULT_META_APP_ID)
META_ES_CONFIG_ID=       # Embedded Signup configuration id (App Dashboard → WhatsApp → Embedded Signup); empty = Connect WhatsApp says it is not set up
META_ES_KEEP_APP=        # 1 when that configuration is Embedded Signup v4 with WhatsApp Business app onboarding (coexistence); empty = the first run offers a number on Chanlytics only
WHATSAPP_TEST_ALLOWLIST= # comma-separated E.164 digits; empty disables the allowlist gate
WHATSAPP_ANSWERS_AS_JOBS= # comma-separated workspace ids, or all: their WhatsApp messages are recorded, acknowledged and answered by a job (lib/whatsapp/answer-later.ts); empty = every message is answered inside the webhook, as before

# Instagram DMs (the Instagram API with Instagram Login: decision 0001, step 8). Messaging an account we do not own needs
# Meta's App Review for instagram_business_basic and instagram_business_manage_messages.
INSTAGRAM_APP_ID=        # the Instagram app id (App Dashboard → Instagram → API setup with Instagram login); empty = Connect Instagram says it is not set up
INSTAGRAM_APP_SECRET=    # its Instagram app secret: the code exchange, the token refresh, and the webhook's signature (META_APP_SECRET is held as the second key)
INSTAGRAM_VERIFY_TOKEN=  # the webhook's verify token, as set in the App Dashboard for /api/instagram; empty = the handshake is refused
INSTAGRAM_REDIRECT_URI=  # the dashboard's /api/v1/channels/instagram/callback, exactly as the App Dashboard lists it

# Retell AI
RETELL_API_KEY=          # the key the edge calls Retell with; also tried for /api/retell-webhook's signature when RETELL_WEBHOOK_KEY is empty
# The API key with the WEBHOOK BADGE in Retell's dashboard: the one Retell signs
# deliveries with, and the only one that verifies them. Set it here so the
# signature verifies without moving every provider call onto it; once
# events of kind webhook.auth show sig=true, the ?key= fallback retires.
RETELL_WEBHOOK_KEY=      # REQUIRED in practice: the badged key Retell signs webhooks with, the only one that can verify them. Unset, the signature never verifies and the ?key= on the agent's webhook_url — which is RETELL_FN_SECRET, the same secret that opens /api/retell-fn — is the only credential admitting deliveries.
TWILIO_ACCOUNT_SID=      # the master account: lines are subaccounts under it (api/admin/lines)
TWILIO_AUTH_TOKEN=
# Chanlytics' own APPROVED primary customer profile in Trust Hub (BU…). Every
# workspace's carrier registration hangs under it; without it none can be
# filed. Read it from the Trust Hub console, or the CustomerProfiles API.
TWILIO_PRIMARY_PROFILE_SID=
LINES_DRY_RUN=           # '1' = the dry line provider (fake SIDs) — previews and laptops only; production ignores it
# Days after a subscription stopped paying before its number goes back to the
# carrier (the lines sweep, lib/lines/line-release.ts). Unset, or under 14, the
# sweep only REPORTS what it would release (line_release_report); set, it warns
# the owner a week before and then releases. A release cannot be undone.
LINE_RELEASE_AFTER_DAYS=
# The secret the three voice doors were provisioned with: ?key= on the inbound
# webhook URL, x-fn-secret on the two tools. Retell's signature opens each door
# on its own; the secret opens a door only while lib/voice/voice-door-auth.ts
# lists it (KEY_READ_FROM), which is where a door is taken off it on evidence.
RETELL_FN_SECRET=
# '1' = no voice door reads RETELL_FN_SECRET: the three (retell-inbound,
# retell-fn, retell-availability) open for Retell's signature alone, as the
# webhook does, and a refusal is logged too. Unset, a door listed in
# voice-door-auth.ts still opens for the secret, and each knock that comes in
# logs voice_door_auth { door, sig }. Set it once that log shows sig: true on
# every door. The verifier tries one key, RETELL_WEBHOOK_KEY (RETELL_API_KEY
# when it is unset): sig: false on the fn and availability doors while the
# webhook shows true can mean the wrong key, not an unsigned delivery.
RETELL_DOORS_SIGNED=

# Email (Resend). LEAD_FROM must be an address on a domain verified in Resend
# (chanlytics.com since 11 September 2026), as `Name <address>` or bare:
# alerts and pages to LEAD_TO, the platform's mailbox, are sent from it.
# LEAD_TO takes one address or several separated by commas; every one is
# paged. A carrier filing that wants one contact takes the first.
RESEND_API_KEY=
LEAD_TO=
LEAD_FROM=
# The support inbox (decision 0066): where Report a problem in the app is mailed, from LEAD_FROM, with the member's
# address as its Reply-To, so the inbox answers them directly. Blank sends reports to LEAD_TO instead.
SUPPORT_TO=
# The email channel's switch: the subdomain that sends AND receives customer
# email through Resend (mail.chanlytics.com), verified there for both, with
# Resend's MX as that subdomain's only MX. Unset, the channel does not exist on
# this deployment: no email wire is bound and nothing about email is drawn. A
# workspace's own switch is its mailboxes row (00126).
EMAIL_DOMAIN=
# The domain OFFERS by email leave from (campaigns.chanlytics.com): a sending
# subdomain on the SAME Resend account as EMAIL_DOMAIN (RESEND_API_KEY), with its
# DNS records published and verified there, so a complaint about an offer never
# touches the domain replies and visit messages leave from. Offers by email go only
# while this is set AND Resend reports it verified (lib/email/campaigns-domain.ts,
# asked at most every five minutes); empty or unverified = they stay refused, as
# they were. Needs UNSUBSCRIBE_SECRET too: every offer carries its unsubscribe.
EMAIL_CAMPAIGNS_DOMAIN=
# The signing secret of the one Resend webhook that points at
# /api/resend-webhook (whsec_...). Every delivery is proven with it before it
# is read; unset, every delivery is refused.
RESEND_WEBHOOK_SECRET=
# The key that seals the one-click unsubscribe every cold email carries in its
# headers (/u/<token> on the dashboard). Set the SAME value as the dashboard's
# UNSUBSCRIBE_SECRET, which opens them; to rotate, deploy the dashboard first
# (its runbook line). Every mailboxes sweep seals a link that names nobody and
# opens it on the dashboard, and pages the platform if the page refuses it
# (email_unsubscribe_links_broken). Empty = no reach-out writes anything.
UNSUBSCRIBE_SECRET=
# Where cold emails' unsubscribe links point (D17), before scale: an https
# origin of a domain of cold mail's own, added to the dashboard's Vercel
# project so /u/<token> answers there (https://links.example.com). The probe
# opens the page there. Set the SAME value on the dashboard, which then
# answers nothing but /u/ on that host. Empty = the dashboard's origin
# (DASHBOARD_ORIGIN).
UNSUBSCRIBE_ORIGIN=

# Connected mailboxes (decision 0056): a business writes its cold email from its
# own Gmail or Microsoft 365 mailbox, connected with OAuth (docs/runbook.md,
# "Connect a mailbox"). A provider whose client is empty is not offered.
# Google: a Google Cloud project of its own (never Business Profile's), its
# OAuth client a web application with gmail.send and gmail.readonly; until
# Google's review and its security assessment pass, 100 users at most.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Microsoft: an app registration for any organisation's accounts, delegated
# Mail.Send, Mail.ReadWrite, User.Read and offline_access, publisher verified.
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
# The callback both return to, registered on each exactly:
#   https://app.chanlytics.com/api/v1/mailbox-connections/callback
MAILBOX_OAUTH_REDIRECT=
# Gmail tells the edge a mailbox changed through Pub/Sub: the topic (projects/
# <project>/topics/<name>, gmail-api-push@system.gserviceaccount.com allowed to
# publish), and the audience its push subscription to /api/mailbox/gmail signs
# its token for. Empty = mailboxes are read by the five-minute sweep alone.
GMAIL_PUSH_TOPIC=
GMAIL_PUSH_AUDIENCE=
# The clientState every Graph subscription carries, checked on each
# notification to /api/mailbox/graph. Empty = the sweep alone.
GRAPH_NOTIFY_SECRET=

# Push (Expo's push service, apps/edge/lib/ops/push.ts). No key is needed to
# send; when set, the access token rides as a bearer so only this deployment
# may send to the app's tokens. Made at expo.dev under the project's access
# tokens.
EXPO_ACCESS_TOKEN=

# Apple's push service, spoken to directly for the call in progress on a phone's Lock Screen (a Live Activity; Expo's
# push service does not carry those). The team id, the key id and the .p8 key from the Apple Developer account (the
# key's PEM, or a base64 of it), and the app's bundle id. All four, or nothing is sent. APNS_SANDBOX=on for a
# development build's tokens.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
APNS_SANDBOX=

# LLM
ANTHROPIC_API_KEY=

# Ask spoken (docs/superpowers/specs/2026-10-03-ask-spoken-design.md): Ask's voice. The key mints a member's
# conversation token (/api/admin/voice/session) and speaks a brief or an answer aloud (/api/admin/voice/speech), and
# deletes a conversation once its minutes are written; the id names the agent THIS edge mints on, provisioned from code
# (tooling/scripts/voice/elevenlabs-agent.mjs: production's `chanlytics-ask`, a laptop's `chanlytics-ask-dev`); the
# webhook secret verifies the post-call delivery (/api/elevenlabs-webhook). Empty = voice is off, and the Line says so.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# A second model asked in shadow (docs/decisions/0023-a-second-model-port-in-shadow.md): TypeSafe's Jev makes calibrated
# decisions, and is put the receptionist's, the reply reader's and the lead judge's closed-set questions beside the
# primary while TYPESAFE_SHADOW is 1 (every workspace) or lists workspace ids (a pilot on those alone, comma
# separated) and the key is set. Its answers are never used; each call is one row of the usage
# ledger, and ai_shadow_agreement reads a week of them. Blank is off. Customer text leaves for TypeSafe when it is on:
# the decision says what must be settled first.
TYPESAFE_API_KEY=
TYPESAFE_SHADOW=
# The receptionist's note suggestions after a call or a quiet conversation
# (docs/decisions/0007-person-notes.md, phase 2): on unless 'off'.
NOTE_SUGGESTIONS=
# Ask's journal (decision 0070): the note sweep writes each active day of a
# workspace in a few sentences, an hour after it ends, for an owner's Ask to
# remember. on = written; empty = off, and nothing is spent.
ASK_JOURNAL=

# The lead finder (docs/plans/2026-09-19-lead-finder-A2-pipeline.md). The
# provider's API token: set by Ruben; the finder is off without it, and every
# lead job then fails loudly rather than guessing.
APIFY_TOKEN=
# The judge's model (PRD decision 3), one constant; empty = claude-opus-5.
LEAD_JUDGE_MODEL=
# The API's server-side fallback on the judge (decision 14): on unless 'off'.
LEAD_JUDGE_FALLBACKS=
# Where the provider's webhook lands: this deployment's origin. Empty = EDGE_ORIGIN, else the address the edge has always had.
LEAD_WEBHOOK_BASE=

# Postgres / control plane — the receptionist's only memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # service role: bypasses RLS. Edge + jobs only, never the browser.

# Google — the public listing (Places API (New)). A server key restricted to
# that one API. Empty = no Google row on Setup, no section on Reports, no
# card on Integrations: the product draws nothing it cannot do.
GOOGLE_PLACES_API_KEY=
# Google — the owner's Business Profile (OAuth, web application). The client
# id and the redirect URI are public by nature; the secret is not. The
# redirect URI must be registered on the client exactly:
#   https://app.chanlytics.com/api/v1/google/callback
# Empty = no Connect button anywhere; the public listing still works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Which audience the OAuth app has on Google's consent screen, so the Connect
# row can say what the person is about to see: testing (only listed test
# users may grant), unverified (in production before Google's review — a
# warning screen), verified. Empty or anything else = the row says nothing.
GOOGLE_OAUTH_AUDIENCE=

# Diagnostics
# The platform's key, x-diag-key: /api/diag and the pager (/api/admin/page) knock
# with it. On an edge that holds EDGE_CALL_SECRET it opens nothing else, and every key-only knock logs
# admin_door_key_only { door, ok }. The eval harness mints a token instead.
DIAG_KEY=
# The secret that verifies the dashboard's per-call token on the admin doors
# (lib/admin-auth.ts). Set the SAME value on the dashboard: holding it, the
# dashboard signs every call and sends no key, and an edge without it refuses
# those calls -- so the two projects hold it together or not at all. Empty (a
# preview) = the doors open on DIAG_KEY alone, compared in constant time.
EDGE_CALL_SECRET=

# Billing (Stripe). All three open the door; without any one of them the
# dashboard draws no button that charges. The webhook endpoint is
# https://chanlytics-messaging.vercel.app/api/stripe-webhook; the price is one
# recurring price on the product. Test-mode keys first, then live.
# The dashboard's origin (https://app.chanlytics.com once the domain is live;
# the Vercel address until then): where Stripe returns the browser. An origin
# only — no path.
DASHBOARD_ORIGIN=
# This deployment's own origin, as a provider must be told to reach it — the
# voice webhooks and the inbound-SMS URL are built from it. Empty = the
# address the edge has always had. An origin only, no path.
EDGE_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Stripe's publishable key (pk_live_… or pk_test_…): the first run's Go live mounts Stripe's embedded Checkout with it
# (decision 0073). Blank: Go live sends the owner to Stripe's hosted page, as before.
STRIPE_PUBLISHABLE_KEY=
# The trial at Checkout, in days (default 14; 0 for none). Left blank, as here,
# it means "unset" and the default applies — the code trims before parsing,
# because Number("") is 0 and a blank would otherwise read as a deliberate zero.
BILLING_TRIAL_DAYS=
