# Chanlytics edge — environment manifest (values live in Vercel project env, Production scope only)
#
# This file is the COMPLETE list of variables apps/edge and the packages it
# bundles read from process.env. A test pins it (tooling/scripts/tests/
# env-manifest.test.mjs): add a process.env read without adding it here and the
# suite fails. Nine variables were missing before that test existed, including
# the two flags that decide where the bot's memory comes from and the Supabase
# credentials — so an environment built from this file persisted nothing, and
# said nothing about it.

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=   # permanent System User token — verify expires_at=0 via /debug_token
WHATSAPP_PHONE_ID=
META_APP_SECRET=
META_APP_ID=             # /api/diag token introspection, and Embedded Signup (the browser hands it to Meta's SDK); empty = the live app (lib/meta-graph.ts DEFAULT_META_APP_ID)
META_ES_CONFIG_ID=       # Embedded Signup configuration id (App Dashboard → WhatsApp → Embedded Signup); empty = Connect WhatsApp says it is not set up
WHATSAPP_TEST_ALLOWLIST= # comma-separated E.164 digits; empty disables the allowlist gate

# Retell AI
RETELL_API_KEY=          # the key the edge calls Retell with; also tried for /api/retell-webhook's signature when RETELL_WEBHOOK_KEY is empty
# The API key with the WEBHOOK BADGE in Retell's dashboard: the one Retell signs
# deliveries with, and the only one that verifies them. Set it here so the
# signature verifies without moving every provider call onto it; once
# events of kind webhook.auth show sig=true, the ?key= fallback retires.
RETELL_WEBHOOK_KEY=      # REQUIRED in practice: the badged key Retell signs webhooks with, the only one that can verify them. Unset, the signature never verifies and the ?key= on the agent's webhook_url — which is RETELL_FN_SECRET, the same secret that opens /api/retell-fn — is the only credential admitting deliveries.
TWILIO_ACCOUNT_SID=      # the master account: lines are subaccounts under it (api/admin/lines)
TWILIO_AUTH_TOKEN=
# Chanlytics' own APPROVED primary customer profile in Trust Hub (BU…). Every
# workspace's carrier registration hangs under it; without it none can be
# filed. Read it from the Trust Hub console, or the CustomerProfiles API.
TWILIO_PRIMARY_PROFILE_SID=
LINES_DRY_RUN=           # '1' = the dry line provider (fake SIDs) — previews and laptops only; production ignores it
RETELL_FN_SECRET=        # shared-secret header on the send_booking_link custom function

# Email (Resend). LEAD_FROM must be an address on a domain verified in Resend
# (chanlytics.com since 11 September 2026), as `Name <address>` or bare:
# alerts and pages to LEAD_TO, the platform's mailbox, are sent from it.
# LEAD_TO takes one address or several separated by commas; every one is
# paged. A carrier filing that wants one contact takes the first.
RESEND_API_KEY=
LEAD_TO=
LEAD_FROM=
# The email channel's switch: the subdomain that sends AND receives customer
# email through Resend (mail.chanlytics.com), verified there for both, with
# Resend's MX as that subdomain's only MX. Unset, the channel does not exist on
# this deployment: no email wire is bound and nothing about email is drawn. A
# workspace's own switch is its mailboxes row (00126).
EMAIL_DOMAIN=
# The signing secret of the one Resend webhook that points at
# /api/resend-webhook (whsec_...). Every delivery is proven with it before it
# is read; unset, every delivery is refused.
RESEND_WEBHOOK_SECRET=

# LLM
ANTHROPIC_API_KEY=

# The lead finder (docs/plans/2026-09-19-lead-finder-A2-pipeline.md). The
# provider's API token: set by Ruben; the finder is off without it, and every
# lead job then fails loudly rather than guessing.
APIFY_TOKEN=
# The judge's model (PRD decision 3), one constant; empty = claude-opus-5.
LEAD_JUDGE_MODEL=
# The API's server-side fallback on the judge (decision 14): on unless 'off'.
LEAD_JUDGE_FALLBACKS=
# Where the provider's webhook lands: this deployment's origin. Empty = EDGE_ORIGIN, else the address the edge has always had.
LEAD_WEBHOOK_BASE=

# Postgres / control plane — the receptionist's only memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # service role: bypasses RLS. Edge + jobs only, never the browser.

# Google — the public listing (Places API (New)). A server key restricted to
# that one API. Empty = no Google row on Setup, no section on Reports, no
# card on Integrations: the product draws nothing it cannot do.
GOOGLE_PLACES_API_KEY=
# Google — the owner's Business Profile (OAuth, web application). The client
# id and the redirect URI are public by nature; the secret is not. The
# redirect URI must be registered on the client exactly:
#   https://app.chanlytics.com/api/v1/google/callback
# Empty = no Connect button anywhere; the public listing still works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Which audience the OAuth app has on Google's consent screen, so the Connect
# row can say what the person is about to see: testing (only listed test
# users may grant), unverified (in production before Google's review — a
# warning screen), verified. Empty or anything else = the row says nothing.
GOOGLE_OAUTH_AUDIENCE=

# Diagnostics
DIAG_KEY=                # x-diag-key header for /api/diag
# The secret that verifies the dashboard's per-call token on the admin doors
# (lib/admin-auth.ts). Set the SAME value on the dashboard. Empty = the doors
# still open on DIAG_KEY alone, compared in constant time.
EDGE_CALL_SECRET=

# Billing (Stripe). All three open the door; without any one of them the
# dashboard draws no button that charges. The webhook endpoint is
# https://chanlytics-messaging.vercel.app/api/stripe-webhook; the price is one
# recurring price on the product. Test-mode keys first, then live.
# The dashboard's origin (https://app.chanlytics.com once the domain is live;
# the Vercel address until then): where Stripe returns the browser. An origin
# only — no path.
DASHBOARD_ORIGIN=
# This deployment's own origin, as a provider must be told to reach it — the
# voice webhooks and the inbound-SMS URL are built from it. Empty = the
# address the edge has always had. An origin only, no path.
EDGE_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# The trial at Checkout, in days (default 14; 0 for none). Left blank, as here,
# it means "unset" and the default applies — the code trims before parsing,
# because Number("") is 0 and a blank would otherwise read as a deliberate zero.
BILLING_TRIAL_DAYS=
