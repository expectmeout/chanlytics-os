{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["**/dist/**", "**/*.generated.ts", "**/database.types.ts", "**/.next/**", "docs/**"],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "classMembers": "off",
    "duplicates": "off",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "catalog": "error"
  },
  "workspaces": {
    ".": {
      "entry": ["eslint.config.mjs", "playwright.config.ts", "e2e/**/*.ts"],
      "project": ["e2e/**/*.ts", "*.{ts,mjs}"],
      "ignoreDependencies": ["esbuild", "lint-staged"]
    },
    "apps/edge": {
      "entry": ["api/**/*.ts"],
      "project": ["api/**/*.ts", "lib/**/*.ts"]
    },
    "apps/dashboard": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "proxy.ts",
        "middleware.ts",
        "next.config.ts",
        "src/*.ts",
        "src/bridge/**/*.{ts,tsx}",
        "src/**/*.type-test.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.{ts,mjs}"]
    },
    "apps/mobile": {
      "entry": ["src/**/*.ios.{ts,tsx}"],
      "ignoreDependencies": ["expo-font", "expo-symbols"]
    },
    "apps/relay": {
      "entry": ["src/index.ts", "proof/key-door.ts", "proof/relay-with-breaks.ts"],
      "project": ["src/**/*.ts", "proof/**/*.ts"]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/write-rules.ts",
        "src/reports/window.ts",
        "src/reports/lens.ts",
        "src/ads/page-entry.ts",
        "src/**/*.type-test.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "tooling/scripts": {
      "entry": [
        "*.mjs",
        "checks/*.mjs",
        "gen/*.mjs",
        "ops/**/*.mjs",
        "voice/*.mjs",
        "e2e-harness/**/*.{ts,tsx,mjs}",
        "mobile/{sign-in,cold-start,walk}.mjs"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "tests": {
      "entry": ["**/*.mjs"],
      "project": ["**/*.mjs"]
    }
  }
}
