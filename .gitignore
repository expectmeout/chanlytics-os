# deps / build
node_modules/
dist/
# workspace package dist IS committed: injected copies must carry built output
# at Vercel install time (see .npmrc). Rebuild via `pnpm --filter "./packages/*" build`.
!packages/*/dist/
.next/
.turbo/
coverage/

# env & secrets — never commit; see apps/edge/.env.example
.env
.env.*
!.env.example

# vercel local link
.vercel/

# large binaries & local-only material (archived outside git)
*.zip
*.mp4
review-videos/
_gen/
apps/dashboard/src/legacy/screenshots/
apps/dashboard/src/legacy/uploads/

# misc
*.log
.DS_Store
