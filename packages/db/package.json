{
  "name": "@chanlytics/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --no-splitting",
    "typecheck": "tsc --noEmit",
    "gen:types": "node ../../tooling/scripts/check-db-types.mjs"
  },
  "dependencies": {
    "@chanlytics/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^7.0.2"
  }
}
