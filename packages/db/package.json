{
  "name": "@chanlytics/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bundled": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./realtime": {
      "types": "./src/realtime.ts",
      "bundled": "./dist/realtime.js",
      "import": "./src/realtime.ts",
      "default": "./src/realtime.ts"
    }
  },
  "scripts": {
    "build": "node ../../tooling/scripts/package-build.mjs",
    "typecheck": "tsc -b",
    "gen:types": "node ../../tooling/scripts/gen/db-types.mjs"
  },
  "dependencies": {
    "@chanlytics/contracts": "workspace:*",
    "@supabase/postgrest-js": "^2.117.2",
    "@supabase/supabase-js": "^2.117.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
