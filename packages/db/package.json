{
  "name": "@chanlytics/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    }
  },
  "scripts": {
    "build": "node ../../tooling/scripts/lf-sources.mjs && tsup src/index.ts --format esm --no-splitting && tsup src/realtime.ts --format esm --no-splitting",
    "typecheck": "tsc --noEmit",
    "gen:types": "node ../../tooling/scripts/gen/db-types.mjs"
  },
  "dependencies": {
    "@chanlytics/contracts": "workspace:*",
    "@supabase/postgrest-js": "^2.117.2",
    "@supabase/supabase-js": "^2.117.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "catalog:"
  }
}
