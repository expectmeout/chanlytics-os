{
  "name": "@chanlytics/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bundled": "./dist/index.js",
      "edge-light": "./src/index.ts",
      "browser": "./src/browser.generated.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./write-rules": {
      "types": "./src/write-rules.ts",
      "bundled": "./dist/write-rules.js",
      "import": "./src/write-rules.ts",
      "default": "./src/write-rules.ts"
    },
    "./report-window": {
      "types": "./src/reports/report-window.ts",
      "bundled": "./dist/report-window.js",
      "import": "./src/reports/report-window.ts",
      "default": "./src/reports/report-window.ts"
    },
    "./report-lens": {
      "types": "./src/reports/report-lens.ts",
      "bundled": "./dist/report-lens.js",
      "import": "./src/reports/report-lens.ts",
      "default": "./src/reports/report-lens.ts"
    },
    "./ads-page": {
      "types": "./src/ads/ads-page.ts",
      "bundled": "./dist/ads-page.js",
      "import": "./src/ads/ads-page.ts",
      "default": "./src/ads/ads-page.ts"
    },
    "./alert-pane": {
      "types": "./src/alert-pane.ts",
      "bundled": "./dist/alert-pane.js",
      "import": "./src/alert-pane.ts",
      "default": "./src/alert-pane.ts"
    },
    "./ask-only": {
      "types": "./src/ask-proposals/ask-only.ts",
      "bundled": "./dist/ask-only.js",
      "import": "./src/ask-proposals/ask-only.ts",
      "default": "./src/ask-proposals/ask-only.ts"
    },
    "./page-specs": {
      "types": "./src/index.ts",
      "bundled": "./dist/index.js",
      "edge-light": "./src/index.ts",
      "browser": "./src/ask-proposals/page-specs.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./phone-app": "./src/mobile/phone-app.ts"
  },
  "sideEffects": [
    "./src/zod-config.ts"
  ],
  "scripts": {
    "build": "node ../../tooling/scripts/package-build.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
