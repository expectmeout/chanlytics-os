{
  "name": "@chanlytics/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./write-rules": {
      "types": "./dist/write-rules.d.ts",
      "import": "./dist/write-rules.js",
      "default": "./dist/write-rules.js"
    },
    "./report-window": {
      "types": "./dist/report-window.d.ts",
      "browser": "./dist/browser/reports/report-window.js",
      "import": "./dist/report-window.js",
      "default": "./dist/report-window.js"
    },
    "./report-lens": {
      "types": "./dist/report-lens.d.ts",
      "browser": "./dist/browser/reports/report-lens.js",
      "import": "./dist/report-lens.js",
      "default": "./dist/report-lens.js"
    },
    "./ads-page": {
      "types": "./dist/ads-page.d.ts",
      "browser": "./dist/browser/ads/ads-page.js",
      "import": "./dist/ads-page.js",
      "default": "./dist/ads-page.js"
    },
    "./alert-pane": {
      "types": "./dist/alert-pane.d.ts",
      "import": "./dist/alert-pane.js",
      "default": "./dist/alert-pane.js"
    },
    "./ask-only": {
      "types": "./dist/ask-only.d.ts",
      "import": "./dist/ask-only.js",
      "default": "./dist/ask-only.js"
    },
    "./phone-app": "./src/mobile/phone-app.ts"
  },
  "sideEffects": [
    "./dist/*.js",
    "./dist/browser/zod-config.js"
  ],
  "scripts": {
    "build": "node ../../tooling/scripts/lf-sources.mjs && tsup && node ../../tooling/scripts/contracts-browser.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "catalog:"
  }
}
