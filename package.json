{
  "name": "chanlytics",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --conditions=react-server --import tsx --test tooling/scripts/tests/*.test.mjs",
    "test:db": "node --import tsx --test tooling/scripts/tests/*.db.test.mjs tooling/scripts/tests/*.integration.test.mjs",
    "gen:schema-sets": "node tooling/scripts/gen-schema-sets.mjs",
    "gen:db-types": "node tooling/scripts/check-db-types.mjs",
    "check:db-types": "node tooling/scripts/check-db-types.mjs --check",
    "check:dist": "node tooling/scripts/check-dist.mjs",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.28",
      "esbuild@<0.28.1": "^0.28.2"
    }
  }
}
