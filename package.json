{
  "name": "chanlytics",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node tooling/scripts/checks/test.mjs",
    "test:db": "node tooling/scripts/checks/test.mjs --db",
    "gen:schema-sets": "node tooling/scripts/gen/schema-sets.mjs",
    "gen:db-types": "node tooling/scripts/gen/db-types.mjs",
    "gen:api-reference": "node --conditions=react-server --import tsx tooling/scripts/gen/api-reference.mjs",
    "check:db-types": "node tooling/scripts/gen/db-types.mjs --check",
    "check:dist": "node tooling/scripts/checks/dist.mjs",
    "check:dead-exports": "node tooling/scripts/checks/dead-exports.mjs",
    "check:bundle": "node tooling/scripts/checks/bundle-budget.mjs",
    "check:style-equality": "node tooling/scripts/checks/style-equality.mjs",
    "lint": "node --max-old-space-size=5120 tooling/scripts/checks/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node tooling/scripts/prepare-hooks.mjs",
    "e2e": "playwright test",
    "e2e:local": "node tooling/scripts/e2e-harness/run.mjs",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lightningcss": "1.33.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  }
}
