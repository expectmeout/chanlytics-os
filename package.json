{
  "name": "chanlytics",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node tooling/scripts/checks/test.mjs",
    "test:db": "node tooling/scripts/checks/test.mjs --db",
    "gen:schema-sets": "node tooling/scripts/gen/schema-sets.mjs",
    "gen:db-types": "node tooling/scripts/gen/db-types.mjs",
    "gen:api-reference": "node --conditions=react-server --import tsx tooling/scripts/gen/api-reference.mjs",
    "gen:schema-snapshot": "node tooling/scripts/gen/schema-snapshot.mjs",
    "gen:data-model": "node tooling/scripts/gen/data-model.mjs",
    "gen:sorted-lists": "node tooling/scripts/gen/sorted-lists.mjs",
    "check:db-types": "node tooling/scripts/gen/db-types.mjs --check",
    "check:dead-exports": "node tooling/scripts/checks/dead-exports.mjs",
    "check:debt": "node --max-old-space-size=5120 --conditions=react-server --import tsx tooling/scripts/checks/debt.mjs",
    "check:bundle": "node tooling/scripts/checks/bundle-budget.mjs",
    "check:static-shell": "node tooling/scripts/checks/static-shell.mjs",
    "check:style-equality": "node tooling/scripts/checks/style-equality.mjs",
    "check:local": "node tooling/scripts/checks/checked-locally.mjs",
    "lint": "node --max-old-space-size=5120 tooling/scripts/checks/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache",
    "prepare": "node tooling/scripts/prepare-hooks.mjs",
    "e2e": "playwright test",
    "e2e:local": "node --import tsx tooling/scripts/e2e-harness/run.mjs",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lightningcss": "1.33.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0"
  }
}
